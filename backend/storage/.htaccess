# Block all direct HTTP access to everything under backend/storage
# (cache files, rate-limit state, and prescription uploads containing
# patient health information). Files here are only ever read from PHP.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
